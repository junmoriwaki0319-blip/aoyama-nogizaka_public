{
  "cleanUrls": true,
  "regions": ["hnd1"],
  "functions": {
    "api/edinet/**/*.js": {
      "maxDuration": 60
    },
    "api/stock-prices.js": {
      "maxDuration": 30
    },
    "api/premium-reports.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    { "source": "/activist-report.html", "destination": "/news/activist-report", "statusCode": 301 },
    { "source": "/activist-report", "destination": "/news/activist-report", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/team", "destination": "/team.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/risk-assessment", "destination": "/risk-assessment.html" },
    { "source": "/activist-dashboard", "destination": "/activist-dashboard.html" },
    { "source": "/activist-screener", "destination": "/activist-screener.html" },
    { "source": "/food-service", "destination": "/food-service.html" },
    { "source": "/saas", "destination": "/saas.html" },
    { "source": "/sogo-shosha", "destination": "/sogo-shosha.html" },
    { "source": "/api/premium-reports", "destination": "/api/premium-reports" },
    { "source": "/api/yahoo/:code", "destination": "/api/yahoo/:code" },
    { "source": "/api/stock/:code", "destination": "/api/stock/:code" },
    { "source": "/api/batch", "destination": "/api/batch" },
    { "source": "/api/stock-prices", "destination": "/api/stock-prices" },
    { "source": "/api/edinet/search/:code", "destination": "/api/edinet/search/:code" },
    { "source": "/api/edinet/xbrl/:docID", "destination": "/api/edinet/xbrl/:docID" },
    { "source": "/api/edinet/land-parcels/:docID", "destination": "/api/edinet/land-parcels/:docID" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://aoyama-nogizaka.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    },
    {
      "source": "/data/activist-materials/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc=' https://www.googletagmanager.com https://cdn.jsdelivr.net https://www.gstatic.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://script.google.com https://*.firebaseio.com https://*.googleapis.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://aoyama-nogizakapublic.vercel.app https://disclosure2.edinet-fsa.go.jp; frame-src https://accounts.google.com https://*.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self' https://script.google.com" }
      ]
    }
  ]
}
